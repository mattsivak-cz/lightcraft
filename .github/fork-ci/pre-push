#!/bin/sh
# git pre-push hook: after a push to the mattsivak/lightcraft fork, mirror every pushed branch to the
# mattsivak-cz/lightcraft org fork and start .github/workflows/fork-ci.yml there (on its fork-ci
# branch). CI runs in the org fork because only an organization can use Depot runners; the personal
# fork stays the home of the branches and the upstream PRs. Install with .github/fork-ci/install-hook.sh.
#
# Never blocks or fails the push: it forks a background job that waits until the pushed commit is on
# GitHub, mirrors it, then dispatches the workflow. Log: $(git rev-parse --git-common-dir)/fork-ci.log.
# Opt out for one push: FORK_CI=0 git push ...

remote_url=$2
[ "${FORK_CI:-1}" = 0 ] && exit 0
case "$remote_url" in
  *github.com[:/]mattsivak/lightcraft|*github.com[:/]mattsivak/lightcraft.git) ;;
  *) exit 0 ;;
esac
command -v gh >/dev/null 2>&1 || exit 0

repo=mattsivak-cz/lightcraft
ci_url=https://github.com/$repo.git
log="$(git rev-parse --git-common-dir)/fork-ci.log"
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}
  [ "$branch" = fork-ci ] && continue # runs from its own push trigger
  (
    # wait (up to ~5 min) for the push to land, then mirror and dispatch
    i=0
    while [ $i -lt 60 ]; do
      if [ "$(git ls-remote "$remote_url" "$remote_ref" 2>/dev/null | cut -f1)" = "$local_sha" ]; then
        # the CI fork is a mirror: force, so rebased branches follow
        if ! FORK_CI=0 git push --quiet --no-verify --force "$ci_url" "$local_sha:$remote_ref"; then
          echo "$(date '+%F %T') FAILED to mirror $branch @ $local_sha to $repo"
          exit 0
        fi
        if gh workflow run fork-ci.yml -R "$repo" --ref fork-ci -f ref="$branch" -f sha="$local_sha" >/dev/null 2>&1; then
          echo "$(date '+%F %T') dispatched fork-ci for $branch @ $local_sha on $repo"
        else
          echo "$(date '+%F %T') FAILED to dispatch fork-ci for $branch @ $local_sha on $repo"
        fi
        exit 0
      fi
      i=$((i + 1))
      sleep 5
    done
    echo "$(date '+%F %T') gave up: $branch never reached $local_sha on mattsivak/lightcraft (push rejected?)"
  ) >>"$log" 2>&1 </dev/null &
done
exit 0
